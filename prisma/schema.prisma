generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
  password String
}

model Staff {
  id         String           @id
  username   String           @unique
  password   String
  createdAt  DateTime         @default(now())
  name       String
  address    String
  birthday   DateTime
  email      String?          @unique
  img        String?
  kecamatan  String
  kelurahan  String
  kota       String
  phone      String           @unique
  religion   Agama
  rt         String
  rw         String
  sex        UserSex
  staffroles staffrole?
  perfomId   PerformanceLog[]
}

model Student {
  id              String           @id
  username        String           @unique
  name            String
  email           String?          @unique
  phone           String?
  address         String
  img             String?
  sex             UserSex
  createdAt       DateTime         @default(now())
  parentId        String?
  classId         Int?
  birthday        DateTime
  religion        Agama
  guardianId      String?
  secondParentId  String?
  kecamatan       String
  kelurahan       String
  kota            String
  rt              String
  rw              String
  password        String
  gradeId         Int?
  attendance      Attendance[]
  studentDb       PPDB?
  paymentLogs     PaymentLog[]
  results         Result[]
  class           Class?           @relation(fields: [classId], references: [id])
  grade           Grade?           @relation(fields: [gradeId], references: [id])
  guardian        Parent?          @relation("Guardian", fields: [guardianId], references: [id])
  parent          Parent?          @relation(fields: [parentId], references: [id])
  secondParent    Parent?          @relation("SecondParent", fields: [secondParentId], references: [id])
  student_details student_details?
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  email     String?   @unique
  phone     String    @unique
  address   String
  img       String?
  sex       UserSex
  createdAt DateTime  @default(now())
  birthday  DateTime
  religion  Agama
  kecamatan String
  kelurahan String
  kota      String
  rt        String
  rw        String
  password  String
  classes   Class[]
  lessons   Lesson[]
  subjects  Subject[] @relation("SubjectToTeacher")
}

model Parent {
  id                String    @id
  username          String    @unique
  name              String
  email             String?   @unique
  phone             String?
  address           String
  createdAt         DateTime  @default(now())
  income            Int
  job               String
  degree            Degree
  birthday          DateTime
  sex               UserSex
  password          String
  waliMurid         parents?
  guardianStudents  Student[] @relation("Guardian")
  students          Student[]
  secondaryStudents Student[] @relation("SecondParent")
}

model student_details {
  id                 Int       @id @default(autoincrement())
  studentId          String    @unique
  nisn               String?   @unique
  npsn               String?   @unique
  no_ijz             String?   @unique
  nik                String?   @unique
  no_kps             String?   @unique
  height             Int?
  weight             Int?
  distance_from_home Int?
  time_from_home     Int?
  number_of_siblings Int?
  postcode           Int?
  awards             String?
  awards_date        DateTime?
  scholarship        String?
  scholarship_detail String?
  kps                KPS?
  tempat_tinggal     TTinggal?
  transportation     String?
  asalSekolah        String?
  birthPlace         String?
  awards_lvl         Awards?
  noWa               String?
  dokumenAkte        String?
  dokumenIjazah      String?
  dokumenKKKTP       String?
  dokumenPasfoto     String?
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PPDB {
  id                 Int       @id @default(autoincrement())
  name               String
  phone              String?
  address            String
  sex                UserSex
  religion           Agama
  email              String?
  nisn               String
  npsn               String
  no_ijz             String
  nik                String
  no_kps             String?
  height             Int
  weight             Int
  distance_from_home Int
  time_from_home     Int
  number_of_siblings Int
  postcode           Int
  awards             String?
  awards_date        DateTime?
  scholarship        String?
  scholarship_detail String?
  scholarship_date   DateTime?
  isvalid            Boolean
  kps                KPS?
  tempat_tinggal     TTinggal
  transportation     String
  asalSekolah        String
  birthPlace         String
  birthday           DateTime
  awards_lvl         Awards?
  noWa               String?
  dokumenAkte        String?
  dokumenIjazah      String?
  dokumenKKKTP       String?
  dokumenPasfoto     String?
  namaAyah           String?
  namaIbu            String?
  namaWali           String?
  pekerjaanAyah      String?
  pekerjaanIbu       String?
  pekerjaanWali      String?
  pendidikanAyah     Degree?
  pendidikanIbu      Degree?
  pendidikanWali     Degree?
  penghasilanAyah    Int?
  penghasilanIbu     Int?
  penghasilanWali    Int?
  tahunLahirAyah     DateTime?
  tahunLahirIbu      DateTime?
  tahunLahirWali     DateTime?
  telpAyah           String?
  telpIbu            String?
  telpWali           String?
  createdAt          DateTime  @default(now())
  kecamatan          String
  kelurahan          String
  kota               String
  rt                 String
  rw                 String
  studentId          String?   @unique
  student            Student?  @relation(fields: [studentId], references: [id])
}

model Grade {
  id          Int          @id @default(autoincrement())
  level       Int          @unique
  classes     Class[]
  paymentLogs PaymentLog[]
  students    Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  capacity      Int
  supervisorId  String?
  gradeId       Int?
  Announcements Announcement[]
  grade         Grade?         @relation(fields: [gradeId], references: [id])
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  Events        Event[]
  lessons       Lesson[]
  paymentLogs   PaymentLog[]
  students      Student[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  lessons  Lesson[]
  teachers Teacher[] @relation("SubjectToTeacher")
}

model Lesson {
  id          Int          @id @default(autoincrement())
  name        String
  day         Day
  // startTime   DateTime
  // endTime     DateTime
  subjectId   Int?
  classId     Int?
  teacherId   String?
  startTime   String       @map("start_time_str") @db.VarChar(5)
  endTime     String       @map("end_time_str") @db.VarChar(5)
  assignments Assignment[]
  attendance  Attendance[]
  exams       Exam[]
  class       Class?       @relation(fields: [classId], references: [id])
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  meetings    Meeting[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int?
  exType    exTypes?
  date      DateTime @default(now())
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Assignment {
  id        Int       @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int?
  assType   assTypes?
  lesson    Lesson?   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String?
  resultType   resTypes?
  createdAt    DateTime    @default(now())
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  exam         Exam?       @relation(fields: [examId], references: [id])
  student      Student?    @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  present   Boolean          @default(false)
  studentId String?
  lessonId  Int?
  meetingId Int?
  status    AttendanceStatus @default(HADIR)
  lesson    Lesson?          @relation(fields: [lessonId], references: [id])
  meeting   Meeting?         @relation(fields: [meetingId], references: [id])
  student   Student?         @relation(fields: [studentId], references: [id])

  @@unique([studentId, meetingId])
}

model Meeting {
  id          Int          @id @default(autoincrement())
  lessonId    Int
  meetingNo   Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  attendances Attendance[]
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  classId     Int?
  endTime     DateTime
  startTime   DateTime
  img         String?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  img         String?
  class       Class?   @relation(fields: [classId], references: [id])
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PaymentLog {
  id                  Int                  @id @default(autoincrement())
  studentId           String
  amount              Decimal              @db.Decimal(12, 2)
  paymentType         PaymentType
  status              PaymentStatus
  dueDate             DateTime
  paidAt              DateTime?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentMethod       String?
  receiptNumber       String?              @unique
  classId             Int?
  gradeId             Int?
  paymentInstallments PaymentInstallment[]
  class               Class?               @relation(fields: [classId], references: [id])
  grade               Grade?               @relation(fields: [gradeId], references: [id])
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changeLogs          PaymentLogChange[]
}

model PaymentInstallment {
  id                Int                @id @default(autoincrement())
  paymentLogId      Int
  amount            Decimal            @db.Decimal(12, 2)
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  paymentLog        PaymentLog         @relation(fields: [paymentLogId], references: [id], onDelete: Cascade)
  installmentChange PaymentLogChange[]
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model Extracurricular {
  id        Int      @id @default(autoincrement())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
}

model SupportActivity {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model PPDBSetting {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  quota     Int
  usedQuota Int      @default(0)
  updatedAt DateTime @updatedAt
  filePpdb  String?
}

model PaymentLogChange {
  id                Int                 @id @default(autoincrement())
  paymentLogId      Int?
  action            ChangeAction
  oldValue          Json?
  newValue          Json?
  changedById       String
  changedByName     String
  changedByRole     String
  createdAt         DateTime            @default(now())
  installmentId     Int?
  revertedFromId    Int?
  plogId            Int?
  isReverted        Boolean             @default(false)
  paymentIstallment PaymentInstallment? @relation(fields: [installmentId], references: [id])
  paymentLog        PaymentLog?         @relation(fields: [paymentLogId], references: [id])
}

model PerformanceLog {
  id        String   @id @default(uuid())
  staffId   String
  score     Int
  month     String
  note      String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model HomeSetting {
  id        Int      @id @default(autoincrement())
  show      Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum staffrole {
  PENILAIAN
  PENJADWALAN
  ACCOUNTING
}

enum parents {
  AYAH
  IBU
  WALI
}

enum exTypes {
  UJIAN_HARIAN
  UJIAN_TENGAH_SEMESTER
  UJIAN_AKHIR_SEMESTER
}

enum assTypes {
  PEKERJAAN_RUMAH
  TUGAS_AKHIR
  TUGAS_HARIAN
}

enum resTypes {
  TUGAS_HARIAN
  TUGAS_AKHIR
  PEKERJAAN_RUMAH
  UJIAN_HARIAN
  UJIAN_TENGAH_SEMESTER
  UJIAN_AKHIR_SEMESTER
}

enum AttendanceStatus {
  HADIR
  SAKIT
  ABSEN
  IZIN
}

enum UserSex {
  MALE
  FEMALE
}

enum KPS {
  KIP
  KIS
  KKS
}

enum TTinggal {
  Orang_Tua
  Wali
  Kost
  Asrama
  Pesantren
  Panti_asuhan
}

enum Awards {
  kecamatan
  kota
  kabupaten
  provinsi
  nasional
  internasional
}

enum Degree {
  TIDAK_ADA
  SD
  SMP
  SMA
  D3
  S1
  S2
  S3
}

enum Agama {
  Islam
  Kristen
  Buddha
  Lainnya
}

enum Day {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

enum PaymentType {
  TUITION
  EXTRACURRICULAR
  UNIFORM
  BOOKS
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
}

enum ChangeAction {
  CREATE_BILL
  CREATE_PAYMENTS
  UPDATE_BILL
  UPDATE_PAYMENTS
  DELETE_BILL
  DELETE_PAYMENTS
  REVERT
  UNREVERT
}
